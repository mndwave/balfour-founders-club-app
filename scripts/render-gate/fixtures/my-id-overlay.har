     "content": {
      "size": -1,
      "mimeType": "application/json",
      "text": "{\"member_tier_order\":1,\"rewards\":[{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":\"Shop now\",\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":null,\"frequency_period\":null,\"id\":\"66e57fb1-bf9f-4384-a47c-169ec45674da\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790672812018-10.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[],\"long_description\":\"Treat yourself, stock up or find something special with 10% off across the Balfour collection. \\n\\nFrom our award-winning English wines and thoughtful gifts to candles, honey and other favourites, enjoy 10% off online or in person at our Cellar Door shop.\\n\\nWhether you’re filling your cellar, choosing a gift or simply picking up something lovely for yourself, there’s plenty to discover.\\n\\nHow to claim:\\n1. Click ‘Shop Now' below\\n2. Add your items to basket and your 10% discount will automatically be applied\\n\\nRedemption details:\\n• Enjoy 10% off eligible Balfour Winery wines, candles, honey, and accessories.\\n• The discount can be used online or in person at the Balfour Winery shop.\\n• The discount cannot be combined with items already on sale.\",\"member_action\":\"activate_links\",\"name\":\"10% Off Award-Winning Wines & More\",\"product_key\":null,\"redemption_type\":\"WEB_STORE\",\"short_description\":\"Enjoy 10% off Balfour, from award-winning wine and gifting to candles, honey and more.\",\"slug\":\"core-webshop-wine-10\",\"sort_order\":1,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:44:46.084924Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":null,\"discount_percent\":10.0,\"dob_on_file\":true,\"exclusive_group\":\"till_percent\",\"frequency_count\":null,\"frequency_period\":null,\"id\":\"af903b70-afb4-49eb-b7f6-c14059c0df93\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790673413583-food.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[],\"long_description\":\"The occasion doesn’t stop at our vineyard. Our love of bringing people together travels beyond Balfour Winery, to our country pubs across Kent. \\n\\nBecause wherever there’s good food, good company and something worth pouring, there’s an occasion waiting to happen. \\n\\nWhere you can use your benefit:\\n• Balfour Winery\\n• The Winemaker’s Pub\\n• The Tickled Trout\\n\\nRedemption details:\\n• Enjoy 10% off food and drink.\\n• Valid at Balfour Winery, The Winemaker’s Pub and The Tickled Trout.\\n• Your QR code must be scanned at the till to redeem the benefit.\",\"member_action\":\"activate_qr\",\"name\":\"10% Off Food & Drink\",\"product_key\":\"87\",\"redemption_type\":\"ZONAL\",\"short_description\":\"Enjoy 10% off food & drinks at Balfour Winery, The Winemaker’s Pub and The Tickled Trout.\",\"slug\":\"core-pubs-food-drink-10\",\"sort_order\":2,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:44:55.547781Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":\"F0UNDERS10\",\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":null,\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":null,\"frequency_period\":null,\"id\":\"527bece1-0b31-4637-addc-d3884c4df48c\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790672926514-stays.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[{\"kind\":\"hls\",\"label\":\"Book The Winemaker's Pub\",\"url\":\"https://live.high-level-software.com/hotels/the-goudhurst-inn/availability/apply-voucher/F0UNDERS10\"},{\"kind\":\"hls\",\"label\":\"Book The Tickled Trout\",\"url\":\"https://live.high-level-software.com/hotels/the-tickled-trout/availability/apply-voucher/F0UNDERS10\"}],\"long_description\":\"Sometimes there’s no need to rush home. Settle in, share a meal, linger over a glass and wake up somewhere beautiful. \\n\\nSome of the best occasions are the ones you don’t have to leave when the evening ends.\\n\\nWhere you can stay:\\n• The Winemaker’s Pub\\n• The Tickled Trout\\n\\nRedemption details:\\n• Enjoy 10% off eligible stays.\\n• Available at The Winemaker’s Pub and The Tickled Trout.\\n• Availability and booking dates are subject to the individual pub’s terms and availability.\",\"member_action\":\"links\",\"name\":\"10% Off Country Pub Stays\",\"product_key\":null,\"redemption_type\":\"ROOM_BOOKINGS\",\"short_description\":\"Enjoy 10% off stays at our Kent country pubs — The Winemaker’s Pub and The Tickled Trout.\",\"slug\":\"core-pub-stays-10\",\"sort_order\":3,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:45:04.265650Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":null,\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":null,\"frequency_period\":null,\"id\":\"f7357396-45c1-47d3-8e41-026085b059af\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790673636936-tours.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[{\"kind\":\"bookinghound\",\"label\":\"Book a tour or tasting\",\"url\":\"https://booking.bookinghound.cloud/fe/book?og=38d8e7dd-9621-4473-ba2f-52c1c138e5d6&mode=r&uniqueId=6\"}],\"long_description\":\"Our Balfour family is at the heart of everything we do.\\n\\nAs our Founders we want you to feel part of our family. So join us and walk the vines, immerse yourself in the story behind our wines and taste a little of what the land and seasons have given us. Wine is what we create, bringing friends and family together is why we do it. \\n\\nHow to claim:\\n1. Click ‘Book a tour or tasting’ to open our booking page.\\n2. Select your preferred tickets and date. Your 25% Founders saving is already applied to the price, so there is no code to enter.\\n\\nRedemption details:\\n• Enjoy 25% off eligible tours and tastings at Balfour Winery.\\n• Book through the link in your Founders Club app to get the reduced price.\\n• The reduced price is set on the booking page, so please use the link rather than the standard tours page.\\n• If you have a Balfour Winery gift voucher to redeem please call us directly on 01622 832794\",\"member_action\":\"links\",\"name\":\"25% Off Tours & Tastings\",\"product_key\":null,\"redemption_type\":\"BOOKINGHOUND\",\"short_description\":\"Enjoy 25% off vineyard tours and guided tastings at Balfour Winery.\",\"slug\":\"core-tours-tastings-25\",\"sort_order\":4,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:45:40.890330Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":false,\"birthday_gated\":true,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":null,\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":1,\"frequency_period\":\"year\",\"id\":\"cf8f9e4f-ed7d-471c-be1b-6cc818bcbfe6\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790670248876-winery-march-25-120-websize.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[],\"long_description\":\"It’s your birthday season — let us raise a glass to you! \\n\\nEnjoy one complimentary glass of wine at Balfour Winery, The Tickled Trout or Winemaker's Pub.\\n\\nTo redeem, activate the reward in the Founders Club app and show your QR code to a member of the team at the venue.\\n\\nChoose from:\\n• 125ml glass from the Leslie’s range\\n• 175ml glass from the Core Stills range\\n\\nHow to claim:\\n1. Order a glass of wine from the stated wine ranges\\n2. Click 'Show my QR code' and the member of the team can scan it\\n\\nRedemption details:\\n• The reward is redeemable from 30 days before to 30 days after your date of birth.\\n• You must have a date of birth recorded on your Founders Club membership to be eligible.\\n• Activate the reward in the Founders Club app and show your QR code to the team at the venue to redeem.\\n• Redeemable only at Balfour Winery, The Tickled Trout or Winemaker's Pub.\\n• One complimentary glass per birthday reward.\\n• Available only on the specified wine ranges and serving sizes.\",\"member_action\":\"activate_qr\",\"name\":\"Birthday Glass of Wine\",\"product_key\":null,\"redemption_type\":null,\"short_description\":\"Celebrate your birthday with a complimentary glass of wine on us.\",\"slug\":\"new-reward-2\",\"sort_order\":7,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-09-29T08:23:08.919211Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":\"Learn more\",\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":null,\"frequency_period\":null,\"id\":\"24214817-96f1-468d-b41a-9e5328bd996f\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790671255436-introduction-to-english-wine-case.webp\",\"instructions\":null,\"is_featured\":true,\"links\":[],\"long_description\":\"Save 30% on our most-gifted Introduction to English Wine Case. \\n\\nA little introduction can lead to occasions worth remembering.\\n\\nOur Introduction to English Wine Case brings together some of our favourite Balfour English wines, with the hope that, more importantly, it brings people together. After all, wine is simply the beginning. The occasion is what matters.\\n\\nHow to claim online:\\n1. Click ‘Shop Now' below\\n2. The offer will automatically be added to your basket\\n\\nHow to claim in our Cellar Door shop:\\n1. Simply let the team know you're wanting to buy our Introduction to English wine case so they can get it made up for you\\n2. Then display your QR code or note your Founders Club membership number at checkout\\n\\nRedemption details:\\n\\n• Save £55 on the Introduction to English Wine Case.\\n• Member price: £120 (usual price £175).\\n• The offer can be used online or in person at the Balfour Winery shop.\\n• The discount applies to the Introduction to English Wine Case only.\",\"member_action\":\"activate_links\",\"name\":\"30% Off the Introduction to English Wine Case\",\"product_key\":null,\"redemption_type\":\"WEB_STORE\",\"short_description\":\"Save £55 on our most-gifted Introduction to English Wine Case — now £120 instead of £175.\",\"slug\":\"core-intro-wine-case\",\"sort_order\":40,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:45:11.506441Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false},{\"audience_restricted\":false,\"audience_rule\":null,\"birthday_eligible\":true,\"birthday_gated\":false,\"category\":\"CORE\",\"claimed_this_period\":false,\"code\":null,\"cost_cash_gbp\":null,\"cost_stars\":0,\"cta_label\":null,\"discount_percent\":null,\"dob_on_file\":true,\"exclusive_group\":null,\"frequency_count\":null,\"frequency_period\":null,\"id\":\"1919a051-5074-424f-a3d3-ca08ae8500c1\",\"image_url\":\"https://media.randalls.boldthin.gs/loyalty/balfour/rewards/1790672429295-case.webp\",\"instructions\":null,\"is_featured\":false,\"links\":[],\"long_description\":\"Our Head Winemaker has brought together a case of Balfour wines chosen and priced exclusively for our Founders Club members. Giving you a chance to open something special and share a few moments with the people around your table. The best wines are rarely enjoyed alone. \\n\\nCases are 25% off retail price.\",\"member_action\":\"coming_soon\",\"name\":\"Exclusive Founders Case Access\",\"product_key\":null,\"redemption_type\":\"COMING_SOON\",\"short_description\":\"A curated case from our Head Winemaker, exclusive to Founders.\",\"slug\":\"core-founders-case-exclusive\",\"sort_order\":50,\"stock_remaining\":null,\"tier_locked\":false,\"trigger_type\":null,\"valid_from\":\"2026-07-30T05:45:19.105586Z\",\"valid_until\":null,\"visible_to_tier_order\":1,\"voucher_expiry_days\":30,\"zonal_auto_apply\":false}]}"
