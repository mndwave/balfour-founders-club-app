     "content": {
      "size": -1,
      "mimeType": "application/json",
      "text": "{\"site_copy\":[{\"key\":\"benefits.core.description\",\"updated_at\":\"2026-10-01T10:29:46.990508Z\",\"value\":\"Founders pricing across every Balfour venue, member shop discounts, six-for-five cases. The everyday perks of being in.\"},{\"key\":\"benefits.core.label\",\"updated_at\":\"2026-07-22T05:49:44.771728Z\",\"value\":\"CORE BENEFIT\"},{\"key\":\"benefits.core.title\",\"updated_at\":\"2026-07-22T05:49:45.205202Z\",\"value\":\"ALWAYS ON, ALWAYS YOURS\"},{\"key\":\"benefits.heading\",\"updated_at\":\"2026-07-22T05:49:44.374872Z\",\"value\":\"YOUR BENEFITS, READY TO USE\"},{\"key\":\"benefits.partner.description\",\"updated_at\":\"2026-07-22T05:49:48.057175Z\",\"value\":\"Carefully chosen Kent regional partners, arts, food and lifestyle. Codes and exclusive links, straight to your phone.\"},{\"key\":\"benefits.partner.label\",\"updated_at\":\"2026-07-22T05:49:47.257766Z\",\"value\":\"PARTNER BENEFIT\"},{\"key\":\"benefits.partner.title\",\"updated_at\":\"2026-07-22T05:49:47.653084Z\",\"value\":\"THE FRIENDS WE KEEP\"},{\"key\":\"benefits.seasonal.description\",\"updated_at\":\"2026-07-22T05:49:46.821221Z\",\"value\":\"A free drink, two-for-one flights, sleepovers at the estate. Fresh moments every quarter — use them while they're here.\"},{\"key\":\"benefits.seasonal.label\",\"updated_at\":\"2026-07-22T05:49:46.014532Z\",\"value\":\"SEASONAL BENEFIT\"},{\"key\":\"benefits.seasonal.title\",\"updated_at\":\"2026-07-22T05:49:46.414286Z\",\"value\":\"THIS QUARTER'S FOUNDERS TABLE\"},{\"key\":\"_canary.field_edit_probe\",\"updated_at\":\"2026-10-23T12:27:55.283158Z\",\"value\":\"canary-probe 1792758475\"},{\"key\":\"footer.address\",\"updated_at\":\"2026-07-22T05:49:49.296870Z\",\"value\":\"Hush Heath Estate · Kent · London\"},{\"key\":\"footer.copyright\",\"updated_at\":\"2026-07-22T05:52:48.928918Z\",\"value\":\"© Balfour Winery 2026. All rights reserved.\\nHush Heath LLP, 73 Cornhill,\\nLondon, EC3V 3QQ.\\nRegistered in England & Wales, no. OC382028.\"},{\"key\":\"founders_cta.body\",\"updated_at\":\"2026-07-22T05:49:48.878163Z\",\"value\":\"One QR. Every Balfour venue — the winery, the wine shop, The Cellar Door, the Courtyard Café, our London pub and hotel. Show it. We do the rest.\"},{\"key\":\"founders_cta.heading\",\"updated_at\":\"2026-07-22T05:49:48.476404Z\",\"value\":\"OPENING THE WINE OPENS THE OCCASION.\"},{\"key\":\"healer_diag_test_1144bc8c\",\"updated_at\":\"2026-09-02T21:07:11.406250Z\",\"value\":\"diagnostic-probe-safe-to-ignore\"},{\"key\":\"hero.signin_prompt\",\"updated_at\":\"2026-07-22T05:52:41.633280Z\",\"value\":\"Already a Founder?\"},{\"key\":\"hero.subtitle\",\"updated_at\":\"2026-07-22T05:52:37.108092Z\",\"value\":\"Our way of thanking our loyal customers. Free to join, free forever — show your card, and you're one of the family.\"},{\"key\":\"hero.title\",\"updated_at\":\"2026-07-22T05:47:59.681317Z\",\"value\":\"BALFOUR FOUNDERS CLUB\"},{\"key\":\"join.footer\",\"updated_at\":\"2026-09-30T12:13:57.602685Z\",\"value\":\"One QR, across Balfour Winery, Winemaker's Pub & The Tickled Trout. You're in the moment you tap.\"},{\"key\":\"join_welcome.body\",\"updated_at\":\"2026-09-30T12:23:59.925527Z\",\"value\":\"Here is your membership card. Show your QR code at any eligible Balfour venue and we’ll do the rest\"},{\"key\":\"join_welcome.complete_body\",\"updated_at\":\"2026-09-30T12:42:39.558540Z\",\"value\":\"Almost there...just add your name & date of birth to unlock your discounts, exclusive offers, birthday treats and more!\"},{\"key\":\"join_welcome.footer\",\"updated_at\":\"2026-09-30T12:15:48.034486Z\",\"value\":\"One QR, across Balfour Winery, Winemaker's Pub & The Tickled Trout. You're in the moment you tap.\"},{\"key\":\"zz.canary.healer0f43c390\",\"updated_at\":\"2026-09-30T20:06:01.474308Z\",\"value\":\"canary value\"}]}"
     },
