<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:founders.balfourwinery.com</string>
		<string>webcredentials:founders.balfourwinery.com</string>
		<string>applinks:balfour.boldthin.gs</string>
		<string>webcredentials:balfour.boldthin.gs</string>
	</array>
	<key>com.apple.developer.pass-type-identifiers</key>
	<array>
		<string>$(TeamIdentifierPrefix)pass.gs.balfour.loyalty</string>
	</array>
</dict>
</plist>
