<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ANDROID-15-STATUS-BAR-SCRIM-2026-07-30 (Kyle, live investigation via
         on-device debug badge): @capacitor/status-bar's overlaysWebView /
         backgroundColor config is documented as "Not available on Android
         15+" — the OS enforces edge-to-edge itself and, unprompted, paints a
         translucent dark contrast-protection scrim behind the status bar
         whenever it can't statically guarantee icon legibility against the
         content underneath (a busy hero photo, in this case) — a flat solid
         background (randalls-rewards-app's dashboard/nav-drawer) doesn't
         trigger it, which is why that app looked fine on the same device
         while this one showed a solid black band. android:*ContrastEnforced
         is API 29+ only — kept in this values-v29/ override rather than the
         base styles.xml so devices below minSdkVersion=24's ceiling but
         under API 29 are unaffected either way. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

</resources>
