<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- WINDOW-BACKGROUND-BLACK-BAND-2026-07-30 (Kyle, live device investigation):
         android:background="@null" below does NOT touch android:windowBackground —
         those are different attributes. windowBackground was never set anywhere in
         this theme chain, so it fell through to Theme.AppCompat.DayNight's own
         default, which resolves to a dark/near-black colour in system dark mode —
         painted by the native Activity window itself, entirely independent of the
         WebView's content, so no web-layer CSS (html/body background-color) could
         ever reach it. Explicit cream here matches the app's actual default theme
         (SplashScreen.backgroundColor in capacitor.config.ts uses the same #fbf6ed). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#fbf6ed</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>