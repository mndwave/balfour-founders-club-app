{
  "about": "SCREEN-GATE-2026-10-20 (healer:26a87acc): shared cases for the per-screen native/web gate. core-rs src/screen_gate.rs runs every case (tests/screen_gate.rs); a shell that re-implements or wraps the gate runs the same file. now = 1792483449 (2026-10-20T08:04:09Z). registry null = never fetched.",
  "now": 1792483449,
  "cases": [
    {"name": "screen not in the build is the hosted page", "screen": "tiers",
     "build": [{"screen_id": "card", "version": 1, "offline_critical": true}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 1, "force_web": false, "force_web_until": 0, "offline_critical": false}]},
     "expect": {"route": "web", "degraded": false, "reason": "not_in_build"}},
    {"name": "nothing in the build, no registry", "screen": "history", "build": [], "registry": null,
     "expect": {"route": "web", "degraded": false, "reason": "not_in_build"}},
    {"name": "first launch offline: native wherever the build has it", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 1, "offline_critical": false}], "registry": null,
     "expect": {"route": "native", "degraded": false, "reason": "no_registry"}},
    {"name": "build matches the registry", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 2, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 2, "force_web": false, "force_web_until": 0, "offline_critical": false}]},
     "expect": {"route": "native", "degraded": false, "reason": "native"}},
    {"name": "build newer than the registry stays native", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 3, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 2, "force_web": false, "force_web_until": 0, "offline_critical": false}]},
     "expect": {"route": "native", "degraded": false, "reason": "native"}},
    {"name": "stale build opens the hosted page", "screen": "history",
     "build": [{"screen_id": "history", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "history", "version": 2, "force_web": false, "force_web_until": 0, "offline_critical": false}]},
     "expect": {"route": "web", "degraded": false, "reason": "stale_build"}},
    {"name": "registry without a row for the screen stays native", "screen": "history",
     "build": [{"screen_id": "history", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "card", "version": 1, "force_web": false, "force_web_until": 0, "offline_critical": true}]},
     "expect": {"route": "native", "degraded": false, "reason": "native"}},
    {"name": "live kill switch opens the hosted page", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 1, "force_web": true, "force_web_until": 1792540800, "offline_critical": false}]},
     "expect": {"route": "web", "degraded": false, "reason": "force_web"}},
    {"name": "cached kill switch past its expiry lapses on the device clock", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 1, "force_web": true, "force_web_until": 1792483000, "offline_critical": false}]},
     "expect": {"route": "native", "degraded": false, "reason": "native"}},
    {"name": "kill switch with no expiry never counts", "screen": "tiers",
     "build": [{"screen_id": "tiers", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "tiers", "version": 1, "force_web": true, "force_web_until": 0, "offline_critical": false}]},
     "expect": {"route": "native", "degraded": false, "reason": "native"}},
    {"name": "offline-critical card is native with no registry", "screen": "card",
     "build": [{"screen_id": "card", "version": 1, "offline_critical": true}], "registry": null,
     "expect": {"route": "native", "degraded": false, "reason": "offline_critical"}},
    {"name": "offline-critical card stays native on a stale build", "screen": "card",
     "build": [{"screen_id": "card", "version": 1, "offline_critical": true}],
     "registry": {"entries": [{"screen_id": "card", "version": 4, "force_web": false, "force_web_until": 0, "offline_critical": true}]},
     "expect": {"route": "native", "degraded": false, "reason": "offline_critical"}},
    {"name": "kill switch on the card only degrades it, never the hosted page", "screen": "card",
     "build": [{"screen_id": "card", "version": 1, "offline_critical": true}],
     "registry": {"entries": [{"screen_id": "card", "version": 1, "force_web": true, "force_web_until": 1792540800, "offline_critical": true}]},
     "expect": {"route": "native", "degraded": true, "reason": "offline_critical"}},
    {"name": "registry marking a screen offline-critical wins over an old build flag", "screen": "card",
     "build": [{"screen_id": "card", "version": 1, "offline_critical": false}],
     "registry": {"entries": [{"screen_id": "card", "version": 2, "force_web": false, "force_web_until": 0, "offline_critical": true}]},
     "expect": {"route": "native", "degraded": false, "reason": "offline_critical"}}
  ]
}
